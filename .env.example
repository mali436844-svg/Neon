# ==============================================================================
# NEON GAMBIT CHESS - ENVIRONMENT CONFIGURATION
# ==============================================================================

# [REQUIRED FOR MULTIPLAYER & GLOBAL LEADERBOARDS]
# PostgreSQL connection string with SSL support.
# Compatible with Neon (neon.tech), Supabase, Vercel Postgres, Railway, etc.
# Example: postgres://default:password@ep-cool-chess-123456.us-east-1.aws.neon.tech/verceldb?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname

# [REQUIRED FOR ADMIN DASHBOARD]
# Secret password used to access the admin dashboard at /admin.
# Pick a strong secret key for production deployments.
ADMIN_PASSWORD=change-me-to-a-secure-password

# [OPTIONAL - LOCAL DEV ONLY]
# Path to Python 3 binary and engine directory.
# On Vercel (serverless), the app automatically and seamlessly falls back
# to the high-performance client-side Web Worker chess engine (ai.worker.ts).
# PYTHON_BIN=python3
# ENGINE_DIR=./engine
